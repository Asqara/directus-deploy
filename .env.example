# =============================================================
#  Salin file ini menjadi .env lalu isi nilainya:
#     cp .env.example .env && nano .env
#  JANGAN pernah commit file .env ke GitHub!
# =============================================================

# Versi Directus (kunci versi agar tidak berubah tiba-tiba)
DIRECTUS_VERSION=12.4.1
DIRECTUS_PORT=8055

# Alamat publik tempat Directus diakses (tanpa garis miring di akhir)
PUBLIC_URL=https://cms.asqara.tech

# Kunci rahasia untuk token login. Buat dengan: openssl rand -hex 32
SECRET=GANTI_DENGAN_HASIL_openssl_rand_hex_32

# Database PostgreSQL
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_YANG_KUAT

# Akun admin pertama
ADMIN_EMAIL=admin@asqara.tech
ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_ADMIN_YANG_KUAT

# Domain frontend yang boleh memanggil API (true = semua domain)
CORS_ORIGIN=true

# Ukuran maksimum file upload
FILES_MAX_UPLOAD_SIZE=100mb

# Lisensi Directus (opsional). Kosongkan = tier Core (gratis).
# Gratis untuk organisasi < $5 juta/tahun via Open Innovation Grant.
LICENSE_KEY=

# Email (opsional). Isi jika ingin fitur "lupa password" & undang user berfungsi.
# EMAIL_TRANSPORT=smtp
# EMAIL_FROM=no-reply@asqara.tech
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=akun@gmail.com
# EMAIL_SMTP_PASSWORD=app-password-gmail
